{
  "name": "desktop-ats",
  "productName": "Desktop ATS Workspace",
  "version": "0.1.0",
  "private": true,
  "main": "dist-main/main.js",
  "scripts": {
    "build:main": "tsc -p main/tsconfig.json",
    "build:renderer": "node scripts/build-renderer.js",
    "test": "npm run build:main && node --test tests/*.test.js",
    "dev": "npm run build:main && node -e \"require('fs').rmSync('renderer/.next',{recursive:true,force:true})\" && concurrently -k \"npm --prefix renderer run dev\" \"wait-on http://localhost:3000 && cross-env ATS_DEV=1 node scripts/electron.js\"",
    "start": "npm run build:main && npm run build:renderer && node scripts/electron.js",
    "fetch-tools": "npm run build:main && node scripts/fetch-tools.js",
    "dist": "npm run build:main && node scripts/fetch-tools.js && npm run build:renderer && electron-builder --win"
  },
  "build": {
    "appId": "com.desktopats.app",
    "files": [
      "dist-main/**",
      "renderer/.next-build/**",
      "package.json",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "ffmpeg.exe",
          "whisper-cli.exe",
          "*.dll",
          "!parakeet*.dll",
          "!llama.dll",
          "!SDL2.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop ATS Workspace",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "asar": true
  },
  "dependencies": {
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "mammoth": "^1.8.0",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "description": "Applicant Tracking System",
  "author": "Desktop ATS"
}
